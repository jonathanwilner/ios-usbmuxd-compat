<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
 <vendor>ios-usbmuxd-compat contributors</vendor>
 <action id="org.ios-usbmuxd-compat.repair">
  <description>Apply or undo a validated iPhone compatibility repair</description>
  <message>Administrator approval is required for this iPhone compatibility operation.</message>
  <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
  <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/ios-usbmuxd-compat/helper</annotate>
 </action>
</policyconfig>
